+def all_dataset_catalog() -> dict[str, dict[str, Any]]:
+    """Return the complete workstation dataset catalog."""
+    catalog: dict[str, dict[str, Any]] = {}
+    for dataset_id, cfg in DATASETS.items():
+        catalog[dataset_id] = dict(cfg, source="core")
+    for dataset_id, cfg in EXTENDED_DATASETS.items():
+        catalog.setdefault(dataset_id, dict(cfg, source="extended"))
+    return catalog
+
+
+def catalog() -> list[dict[str, Any]]:
+    """Print a machine-readable dataset catalog."""
+    rows = []
+    for dataset_id, cfg in all_dataset_catalog().items():
+        rows.append({
+            "dataset_id": dataset_id,
+            "description": cfg.get("description", ""),
+            "target": cfg.get("target"),
+            "filename": cfg.get("filename"),
+            "source": cfg.get("source", "core"),
+            "url": cfg.get("url"),
+        })
+    print(json.dumps(rows, indent=2, ensure_ascii=False))
+    return rows
+
