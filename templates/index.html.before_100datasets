<body>
    <nav class="navbar navbar-expand-lg navbar-custom py-3">
        <div class="container">
            <a class="navbar-brand text-blue fw-bold fs-4" href="#">
                🛡️ Enterprise Multi-Scheme HE Engine v5.0
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success">● Docker Ready (Ubuntu 24.04)</span>
                <span class="badge bg-primary">NIST/128-bit Security Autotuned</span>
                <span class="badge bg-indigo text-white" style="background-color: #4f46e5;">Parallel CPU Accelerated</span>
            </div>
        </div>
