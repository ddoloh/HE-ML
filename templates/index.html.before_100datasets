    <div class="container my-4">
        <!-- Banner -->
        <div class="card card-custom p-3 mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h5 class="text-blue mb-1">엔터프라이즈 멀티 스키마 동형암호 & 병렬 CPU 딥러닝 플랫폼</h5>
                    <p class="text-secondary mb-0 small">4대 동형암호 표준 스키마(CKKS, BFV, TFHE, Paillier), 보안 레벨 검증, 노이즈 오토튜너 및 멀티스레드 병렬 가속을 제공합니다.</p>
                </div>
            </div>
        </div>

        <!-- Row 1: Security Validation & Parallel CPU Acceleration (Improvements 1, 2, 3) -->
        <div class="row">
            <div class="col-lg-6">
                <div class="card card-custom">
                    <div class="card-header card-header-custom">
                        🛡️ 개선점 1 & 3: 동형암호 보안 표준 검증 및 노이즈 오토튜너
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary small">보안 레벨 (NIST Standard):</label>
                                <select id="secLevelSelect" class="form-select bg-dark text-white border-secondary">
                                    <option value="128_bit">128-bit Standard Security (권장)</option>
                                    <option value="192_bit">192-bit High Security</option>
                                    <option value="256_bit">256-bit Ultra High Security (양자내성)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary small">현재 노이즈 레벨 (Noise):</label>
                                <input type="number" id="noiseVal" class="form-control bg-dark text-white border-secondary" value="12.5">
                            </div>
                        </div>
                        <button onclick="validateSecurityLevel()" class="btn btn-indigo w-100 py-2">
                            🔍 보안 컴플라이언스 및 노이즈 오토튜닝 검증
                        </button>
                        <div class="mt-3">
                            <div id="secResult" class="result-box">
                                <span class="text-muted">보안 레벨을 검증하고 노이즈 재스케일링 상태를 확인하세요.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card card-custom">
                    <div class="card-header card-header-custom">
                        ⚡ 개선점 2: 멀티스레드 CPU 병렬 추론 가속기
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary small">모델 선택 (Model):</label>
                                <select id="parallelModelSelect" class="form-select bg-dark text-white border-secondary">
                                    <option value="mobilenet_v3">MobileNetV3-Lite (비전)</option>
                                    <option value="minilm_quantized">MiniLM-Quantized (NLP)</option>
                                    <option value="lightgbm_cpu">LightGBM-CPU (정형)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary small">CPU 워커 스레드 수 (Workers):</label>
                                <input type="number" id="workerCount" class="form-control bg-dark text-white border-secondary" value="4">
                            </div>
                        </div>
                        <button onclick="runParallelBenchmark()" class="btn btn-indigo w-100 py-2">
                            🚀 병렬 CPU 멀티스레드 가속 벤치마크
                        </button>
                        <div class="mt-3">
                            <div id="parallelResult" class="result-box">
                                <span class="text-muted">멀티스레드 가속으로 초당 처리량(Throughput) 상승을 확인하세요.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: 4-Scheme Comparison Matrix -->
        <div class="row">
            <div class="col-12">
                <div class="card card-custom">
                    <div class="card-header card-header-custom d-flex justify-content-between align-items-center">
                        <span>📊 4대 동형암호 표준 스키마(CKKS, BFV, TFHE, Paillier) 종합 비교 매트릭스</span>
                        <button onclick="runMultiCompare()" class="btn btn-sm btn-outline-info">
                            ⚡ 4대 스키마 동시 비교
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-bordered border-secondary align-middle small mb-0">
                                <thead>
                                    <tr class="table-active text-blue">
                                        <th>스키마</th>
                                        <th>표준 명세 및 특징</th>
                                        <th>데이터 타입</th>
                                        <th>예측/출력 결과</th>
                                        <th>레이턴시</th>
                                    </tr>
                                </thead>
                                <tbody id="compareTableBody">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            '4대 스키마 동시 비교' 버튼을 눌러 비교 매트릭스를 확인하세요.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function validateSecurityLevel() {
            const secLevel = document.getElementById('secLevelSelect').value;
            const noise = Number(document.getElementById('noiseVal').value);

            const res = await fetch('/api/v1/security/validate', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({security_level: secLevel, noise_level: noise})
            });
            const data = await res.json();

            document.getElementById('secResult').innerHTML = `
                <div class="text-blue"><b>[${data.security_compliance.level_name}]</b></div>
                • 다항식 차원(N): <span class="text-green">${data.security_compliance.poly_modulus_degree}</span><br>
                • 허용 최대 log(Q): <span class="text-green">${data.security_compliance.max_allowed_log_q} bits</span><br>
                • 표준 준수 여부: <span class="badge bg-success">COMPLIANT (표준 준수)</span><br>
                <hr class="my-2 border-secondary">
                • 노이즈 오토튜너 상태: <span class="text-gold">${data.noise_autotuner.status}</span><br>
                • 오토튜닝 후 노이즈: <span class="text-green">${data.noise_autotuner.refreshed_noise}</span>
            `;
        }

        async function runParallelBenchmark() {
            const modelId = document.getElementById('parallelModelSelect').value;
            const workers = Number(document.getElementById('workerCount').value);

            const res = await fetch('/api/v1/parallel/benchmark', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({model_id: modelId, sample_count: 40, max_workers: workers})
            });
            const data = await res.json();

            document.getElementById('parallelResult').innerHTML = `
                <div class="text-blue"><b>[CPU 병렬 가속 결과 - ${data.model_id}]</b></div>
                • 사용된 CPU 스레드 수: <span class="text-purple">${data.threads_used} Threads</span><br>
                • 처리된 배치 샘플 수: <span class="text-gold">${data.batch_sample_count} Samples</span><br>
                • <b>총 연산 소요시간</b>: <span class="text-green">${data.parallel_latency_ms} ms</span><br>
                • <b>병렬 처리량(Throughput)</b>: <span class="text-blue fw-bold">${data.parallel_throughput_samples_per_sec} samp/sec</span>
            `;
        }

        async function runMultiCompare() {
            const res = await fetch('/api/v1/compare/schemes', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({task: 'lstm', target_id: 'sine_wave'})
            });
            const data = await res.json();

            let rowsHtml = '';
            data.scheme_comparison.forEach((s) => {
                rowsHtml += `
                    <tr>
                        <td class="text-blue fw-bold">${s.scheme_id.toUpperCase()}</td>
                        <td class="text-secondary">${s.scheme_name}</td>
                        <td class="text-purple">${s.data_type}</td>
                        <td class="text-green fw-bold">${s.prediction}</td>
                        <td class="text-gold fw-bold">${s.latency_ms} ms</td>
                    </tr>
                `;
            });
            document.getElementById('compareTableBody').innerHTML = rowsHtml;
        }
    </script>
</body>
</html>


<!-- ============================================================
     Workstation LSTM Benchmark
     ============================================================ -->
<div class="container my-4">
    <div class="card card-custom">
        <div class="card-header card-header-custom d-flex justify-content-between align-items-center">
            <span>🧪 Workstation LSTM Benchmark</span>

            <button
                onclick="loadWorkstationBenchmark()"
                class="btn btn-sm btn-outline-info">
                🔄 새로고침
            </button>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <div class="text-secondary small">
                    실제 시계열 데이터셋 workstation LSTM benchmark
                </div>

                <div
                    id="workstationBenchmarkStatus"
                    class="text-muted small mt-1">
                    결과를 불러오는 중...
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered border-secondary align-middle small mb-0">

                    <thead>
                        <tr class="table-active text-blue">
                            <th>Dataset</th>
                            <th>Target</th>
                            <th>Points</th>
                            <th>Seq</th>
                            <th>Epochs</th>
                            <th>Raw MAE</th>
                            <th>Raw RMSE</th>
                            <th>Norm MAE</th>
                            <th>Norm RMSE</th>
                            <th>R²</th>
                            <th>Train</th>
                        </tr>
                    </thead>

                    <tbody id="workstationBenchmarkBody">
                        <tr>
                            <td colspan="11"
                                class="text-center text-muted py-4">
                                Workstation benchmark 결과를 불러오는 중입니다.
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>

            <div class="mt-3 small text-secondary">
                Raw MAE/RMSE는 원래 데이터 scale이며,
                Normalized MAE/RMSE와 R²는 dataset 간 비교용 지표입니다.
            </div>

        </div>
    </div>
</div>

<script>
function wbNumber(value, digits = 4) {
    if (
        value === null ||
        value === undefined ||
        value === "" ||
        !Number.isFinite(Number(value))
    ) {
        return "-";
    }

    return Number(value).toLocaleString(undefined, {
        maximumFractionDigits: digits
    });
}

function wbMetric(item, metrics, names) {
    for (const name of names) {
        if (item[name] !== undefined && item[name] !== null) {
            return item[name];
        }

        if (metrics[name] !== undefined && metrics[name] !== null) {
            return metrics[name];
        }
    }

    return null;
}

async function loadWorkstationBenchmark() {
    const body =
        document.getElementById("workstationBenchmarkBody");

    const status =
        document.getElementById("workstationBenchmarkStatus");

    if (!body || !status) {
        return;
    }

    body.innerHTML = `
        <tr>
            <td colspan="11"
                class="text-center text-muted py-4">
                benchmark 결과를 불러오는 중...
            </td>
        </tr>
    `;

    try {
        const response = await fetch(
            "/api/v1/workstation/benchmark",
            {
                cache: "no-store"
            }
        );

        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.error ||
                data.detail ||
                "HTTP " + response.status
            );
        }

        const results =
            Array.isArray(data.results)
                ? data.results
                : [];

        if (results.length === 0) {
            body.innerHTML = `
                <tr>
                    <td colspan="11"
                        class="text-center text-muted py-4">
                        아직 benchmark 결과가 없습니다.<br>
                        <code>
                        python workstation_train.py benchmark --datasets all --epochs 3 --max-points 1500 --seq-len 24
                        </code>
                    </td>
                </tr>
            `;

            status.textContent =
                "Benchmark 결과 없음";

            return;
        }

        let html = "";

        for (const item of results) {

            if (item.status === "error") {

                html += `
                    <tr>
                        <td class="text-warning fw-bold">
                            ${item.dataset_id || "-"}
                        </td>

                        <td colspan="9"
                            class="text-danger">
                            ${item.error || "benchmark error"}
                        </td>

                        <td>-</td>
                    </tr>
                `;

                continue;
            }

            const metrics =
                item.metrics || {};

            const rawMae = wbMetric(
                item,
                metrics,
                [
                    "raw_mae",
                    "mae"
                ]
            );

            const rawRmse = wbMetric(
                item,
                metrics,
                [
                    "raw_rmse",
                    "rmse"
                ]
            );

            const normalizedMae = wbMetric(
                item,
                metrics,
                [
                    "normalized_mae",
                    "nmae",
                    "norm_mae"
                ]
            );

            const normalizedRmse = wbMetric(
                item,
                metrics,
                [
                    "normalized_rmse",
                    "nrmse",
                    "norm_rmse"
                ]
            );

            const r2 = wbMetric(
                item,
                metrics,
                [
                    "r2",
                    "R2",
                    "r_squared"
                ]
            );

            html += `
                <tr>

                    <td class="text-blue fw-bold">
                        ${item.dataset_id || "-"}
                    </td>

                    <td>
                        ${item.target || "-"}
                    </td>

                    <td>
                        ${wbNumber(item.points, 0)}
                    </td>

                    <td>
                        ${wbNumber(item.seq_len, 0)}
                    </td>

                    <td>
                        ${wbNumber(item.epochs, 0)}
                    </td>

                    <td>
                        ${wbNumber(rawMae)}
                    </td>

                    <td>
                        ${wbNumber(rawRmse)}
                    </td>

                    <td class="text-green fw-bold">
                        ${wbNumber(normalizedMae)}
                    </td>

                    <td class="text-green fw-bold">
                        ${wbNumber(normalizedRmse)}
                    </td>

                    <td class="text-gold fw-bold">
                        ${wbNumber(r2)}
                    </td>

                    <td>
                        ${wbNumber(item.train_seconds, 2)} s
                    </td>

                </tr>
            `;
        }

        body.innerHTML = html;

        status.textContent =
            `${results.length}개 dataset benchmark`;

    } catch (error) {

        console.error(
            "Workstation benchmark load failed:",
            error
        );

        body.innerHTML = `
            <tr>
                <td colspan="11"
                    class="text-center text-danger py-4">

                    Benchmark 결과를 불러오지 못했습니다.

                    <div class="small mt-2">
                        ${error.message}
                    </div>

                </td>
            </tr>
        `;

        status.textContent =
            "Benchmark 로딩 실패";
    }
}

document.addEventListener(
    "DOMContentLoaded",
    function () {
        loadWorkstationBenchmark();
    }
);
</script>

