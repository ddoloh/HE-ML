+    async function loadWorkstationBenchmark() {
+        const body = document.getElementById(
+            'workstationBenchmarkBody'
+        );
+        const meta = document.getElementById(
+            'workstationBenchmarkMeta'
+        );
+
+        try {
+            const res = await fetch(
+                '/api/v1/workstation/benchmark',
+                {cache: 'no-store'}
+            );
+
+            const data = await res.json();
+
+            if (!res.ok || data.status !== 'success') {
+                body.innerHTML = `
+                    <tr>
+                        <td colspan="8"
+                            class="text-center text-muted py-4">
+                            아직 benchmark 결과가 없습니다.
+                            workstation_train.py benchmark를 먼저 실행하세요.
+                        </td>
+                    </tr>
+                `;
+                meta.textContent = 'Benchmark 결과 없음';
+                return;
+            }
+
+            const rows = data.results || [];
+            meta.textContent = `총 ${rows.length}개 데이터셋`;
+
+            body.innerHTML = rows.map((r) => {
+                if (r.status === 'error') {
+                    return `
+                        <tr>
+                            <td class="fw-bold">${r.dataset_id}</td>
+                            <td>${r.category || '-'}</td>
+                            <td colspan="6"
