+async def workstation_benchmark():
+    """
+    Return the latest workstation benchmark generated by
+    workstation_train.py.
+    """
+    benchmark_path = os.path.join(
+        BASE_DIR,
+        "results",
+        "workstation",
+        "benchmark.json",
+    )
+
+    if not os.path.exists(benchmark_path):
+        return JSONResponse(
+            status_code=404,
+            content={
+                "status": "not_ready",
+                "message": (
+                    "Run workstation_train.py benchmark first."
+                ),
+                "results": [],
+            },
+        )
+
+    try:
+        import json
+
+        with open(
+            benchmark_path,
+            "r",
+            encoding="utf-8",
+        ) as f:
+            results = json.load(f)
+
+        return {
+            "status": "success",
+            "count": len(results),
+            "results": results,
+        }
+
+    except Exception as exc:
+        return JSONResponse(
+            status_code=500,
+            content={
+                "status": "error",
+                "message": repr(exc),
+                "results": [],
+            },
+        )
